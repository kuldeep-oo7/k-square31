{
  "manifest_version": 3,
  "name": "K² GM Portfolio Extractor",
  "version": "2.0.0",
  "description": "Automatically synchronize the signed-in GM Global portfolio to the private K² account every 30 minutes.",
  "permissions": ["activeTab", "alarms", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://gmglobal.org/*",
    "https://k-square31.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gmglobal.org/*"],
      "js": ["gm-hook-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gmglobal.org/*"],
      "js": ["gm-collector.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "K² GM Portfolio Extractor",
    "default_popup": "popup.html"
  }
}
